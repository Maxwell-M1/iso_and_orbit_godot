[internationalization]

locale/translations=PackedStringArray("res://l10n/ui/es.po", "res://l10n/ui/ja.po", "res://l10n/ui/pt_BR.po", "res://l10n/ui/ru.po", "res://l10n/ui/tr.po", "res://l10n/ui/zh_CN.po")

[layer_names]

3d_physics/layer_1="world"
3d_navigation/layer_1="ground"
3d_physics/layer_2="characters"
3d_physics/layer_3="camera"

[navigation]

3d/default_cell_height=0.025

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=5
anti_aliasing/quality/msaa_3d=2
