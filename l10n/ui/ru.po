msgstr "На месте"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Running"
msgstr "Бег"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Sprinting"
msgstr "Бег с ускорением"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Jumping"
msgstr "Прыжок"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Falling"
msgstr "Падение"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "step, %s"
msgstr "шаг, %s"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "touched the ground at %.1f m/s"
msgstr "коснулся земли на %.1f м/с"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "landing at %.1f m/s"
msgstr "приземление на %.1f м/с"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "stair %+.2f m"
msgstr "ступень %+.2f м"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "sprint started"
msgstr "ускорение началось"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "sprint ended"
msgstr "ускорение закончилось"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "%.2f s"
msgstr "%.2f с"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "left foot"
msgstr "левая нога"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "right foot"
msgstr "правая нога"

#: gdscript/ui/settings/settings_screen.gd
msgid " (%d Hz)"
msgstr " (%d Гц)"

#: gdscript/ui/settings/settings_screen.gd
msgid "With V-Sync there are never more frames than the monitor's refresh rate%s, and an FPS limit above it has no effect. The smoothest limits are those that divide this rate evenly."
msgstr "С V-Sync кадров не бывает больше частоты монитора%s, и предел FPS выше неё не действует. Ровнее всего пределы, на которые эта частота делится без остатка."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Language"
msgstr "Язык"
