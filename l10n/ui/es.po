msgid "8 · Necromancer"
msgstr "8 · Nigromante"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "9 · Archmage"
msgstr "9 · Archimago"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "10 · Battle Mage"
msgstr "10 · Mago de batalla"

#: shared/world/world.tscn
msgid "Knight"
msgstr "Caballero"

#: shared/world/world.tscn
msgid "Ranger"
msgstr "Explorador"

#: shared/world/world.tscn
msgid "Wizard"
msgstr "Mago"

#: shared/world/world.tscn
msgid "Dwarf"
msgstr "Enano"

#: shared/world/world.tscn
msgid "Rogue"
msgstr "Pícaro"

#: shared/world/mountain/mountain.tscn
msgid "Windswept Peak"
msgstr "Cumbre de los Vientos"

#: shared/world/world.tscn
msgid "Travelers' Camp"
msgstr "Campamento de Viajeros"

