msgid ""
msgstr ""
"Project-Id-Version: Iso & Orbit - Camera and Character Controller Template\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: gdscript/main.tscn
msgid ""
"{move_to_cursor} on the ground — run there\n"
"Hold {move_to_cursor} — run after the cursor\n"
"{camera_rotate} + mouse — orbit the camera\n"
"{camera_zoom_in/camera_zoom_out} — lower or raise the camera\n"
"Hold {camera_rotate}, then {move_to_cursor} — run where the camera looks"
msgstr ""
"{move_to_cursor} en el suelo — correr allí\n"
"Mantener {move_to_cursor} — correr tras el cursor\n"
"{camera_rotate} + mouse — orbitar la cámara\n"
"{camera_zoom_in/camera_zoom_out} — bajar o subir la cámara\n"
"Mantener {camera_rotate} y luego {move_to_cursor} — correr adonde mira la cámara"

#: gdscript/main.tscn
msgid "Hold {move_to_cursor}, then {camera_rotate} — look around on the run"
msgstr "Mantener {move_to_cursor} y luego {camera_rotate} — mirar alrededor al correr"

#: gdscript/main.tscn
msgid "{camera_rotate} + {move_forward+move_left+move_back+move_right} — move relative to the camera"
msgstr "{camera_rotate} + {move_forward+move_left+move_back+move_right} — moverse según la cámara"

#: gdscript/main.tscn
msgid "{move_to_cursor} + {camera_rotate} + {move_left/move_right} — run diagonally"
msgstr "{move_to_cursor} + {camera_rotate} + {move_left/move_right} — correr en diagonal"

#: gdscript/main.tscn
msgid "{sprint} — run faster"
msgstr "{sprint} — correr más rápido"

#: gdscript/main.tscn
msgid "{jump} — jump"
msgstr "{jump} — saltar"

#: gdscript/main.tscn
msgid "{toggle_settings} — settings"
msgstr "{toggle_settings} — configuración"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Settings"
msgstr "Configuración"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Controls"
msgstr "Controles"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Held {move_to_cursor}"
msgstr "{move_to_cursor} mantenido"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Straight to the cursor"
msgstr "Directo al cursor"

#: gdscript/ui/settings/settings_screen.tscn
msgid "To the point along a path"
msgstr "Al punto por una ruta"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Off"
msgstr "Desactivado"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sidestep: face forward, {move_back} backs up"
msgstr "Lateral: de frente, {move_back} retrocede"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Turn: face the way you go, {move_back} toward the camera"
msgstr "Giro: hacia donde vas, {move_back} hacia la cámara"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sidestep: face forward"
msgstr "Lateral: de frente"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Diagonal: face the way you go"
msgstr "Diagonal: hacia donde vas"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Backing up ({move_back}) slower by"
msgstr "Retroceso ({move_back}) más lento en"

#: gdscript/ui/settings/settings_screen.tscn
msgid "With {camera_rotate}, {move_forward} leads where the camera looks. Sidestepping, the character faces the way the camera does: {move_left} and {move_right} step aside, {move_back} backs up. Turning, the character faces the way they go: {move_left} and {move_right} go left and right, {move_back} toward the camera. With {move_to_cursor} + {camera_rotate}, {move_left} and {move_right} veer the run diagonally forward."
msgstr "Con {camera_rotate}, {move_forward} avanza hacia donde mira la cámara. En modo lateral, el personaje mira como la cámara: {move_left} y {move_right} van de costado, {move_back} retrocede. En modo giro, el personaje mira hacia donde va: {move_left} y {move_right} van a izquierda y derecha, {move_back} hacia la cámara. Con {move_to_cursor} + {camera_rotate}, {move_left} y {move_right} desvían la carrera en diagonal hacia adelante."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Hide the cursor while running with {move_to_cursor} held"
msgstr "Ocultar cursor al correr con {move_to_cursor} mantenido"

#: gdscript/ui/settings/settings_screen.tscn
msgid "The cursor hides as soon as a press becomes a hold and comes back on release, where you aimed."
msgstr "El cursor se oculta en cuanto la pulsación pasa a ser mantenida y reaparece al soltar, donde apuntaste."

#: gdscript/ui/settings/settings_screen.tscn
msgid "{camera_rotate} while running with {move_to_cursor} only turns the camera"
msgstr "{camera_rotate} al correr con {move_to_cursor} solo gira la cámara"

#: gdscript/ui/settings/settings_screen.tscn
msgid "{move_to_cursor}, then {camera_rotate}: look around while the character keeps its course; afterwards the mouse steers on from where you aimed. {camera_rotate} first, or both together: run where the camera looks. Off: {move_to_cursor} and {camera_rotate} run where the camera looks in any order."
msgstr "{move_to_cursor} y luego {camera_rotate}: mira alrededor mientras el personaje mantiene el rumbo; después el mouse sigue guiando desde donde apuntabas. {camera_rotate} primero, o ambos a la vez: correr adonde mira la cámara. Desactivado: {move_to_cursor} y {camera_rotate} corren adonde mira la cámara en cualquier orden."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Character"
msgstr "Personaje"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Hero look"
msgstr "Aspecto del héroe"

#: gdscript/ui/settings/settings_screen.tscn
msgid "All looks stand in a row south of the road to the ramp, each with its number overhead."
msgstr "Todos los aspectos están en fila al sur del camino a la rampa, cada uno con su número encima."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Float above the ground"
msgstr "Flotar sobre el suelo"

#: gdscript/ui/settings/settings_screen.tscn
msgid "The hero hangs above the ground and glides over stairs, with no footsteps. Slopes, stairs and jumps work as usual."
msgstr "El héroe flota sobre el suelo y se desliza sobre las escaleras, sin sonido de pasos. Las pendientes, los escalones y los saltos funcionan como siempre."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Don't fall off ledges"
msgstr "No caer por los bordes"

#: gdscript/ui/settings/settings_screen.tscn
msgid "At an edge the character stops, or slides along it when running at an angle, as along a wall. Low steps can still be walked down."
msgstr "En un borde el personaje se detiene o, si corre en ángulo, se desliza a lo largo de él, como junto a una pared. Los escalones bajos se pueden bajar igual."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Jump ({jump})"
msgstr "Salto ({jump})"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Jump height"
msgstr "Altura del salto"

#: gdscript/ui/settings/settings_screen.tscn
msgid "%.1f m"
msgstr "%.1f m"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sprint ({sprint})"
msgstr "Sprint ({sprint})"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Hold"
msgstr "Mantener"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Press: on, again: off"
msgstr "Presionar para alternar"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Speed bonus"
msgstr "Velocidad extra"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sprint fatigue"
msgstr "Fatiga del sprint"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Stamina lasts"
msgstr "La resistencia dura"

#: gdscript/ui/settings/settings_screen.tscn
msgid "%.1f s"
msgstr "%.1f s"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Camera"
msgstr "Cámara"

#: gdscript/ui/settings/settings_screen.tscn
msgid "{camera_rotate} tilts the camera up and down"
msgstr "{camera_rotate} inclina la cámara arriba/abajo"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Off: {camera_rotate} with the mouse only orbits the camera around the character, and {camera_zoom_in/camera_zoom_out} sets its height and tilt."
msgstr "Desactivado: {camera_rotate} con el mouse solo orbita la cámara alrededor del personaje, y {camera_zoom_in/camera_zoom_out} fija su altura e inclinación."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Turn the camera to follow the run"
msgstr "Girar la cámara siguiendo la carrera"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Align the camera tilt on the run"
msgstr "Alinear inclinación de cámara al correr"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Tilt down"
msgstr "Inclinación hacia abajo"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Align the tilt in"
msgstr "Alinear la inclinación en"

#: gdscript/ui/settings/settings_screen.tscn
msgid "While the character runs, the camera eases to this tilt. {camera_zoom_in/camera_zoom_out} (and {camera_rotate}, if it tilts the camera) changes the tilt as usual, and on the run it eases back."
msgstr "Mientras el personaje corre, la cámara pasa suavemente a esta inclinación. {camera_zoom_in/camera_zoom_out} (y {camera_rotate}, si inclina la cámara) cambia la inclinación como siempre, y al correr vuelve suavemente."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Turn in"
msgstr "Girar en"

#: gdscript/ui/settings/settings_screen.tscn
msgid "instant"
msgstr "al instante"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Except a run toward the camera"
msgstr "Excepto al correr hacia la cámara"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Angle"
msgstr "Ángulo"

#: gdscript/ui/settings/settings_screen.tscn
msgid "When the character runs toward you, straight at the camera or up to this angle off, the camera does not swing round. A run farther to the side turns it, gently at first. Off: the camera turns behind any run."
msgstr "Cuando el personaje corre hacia ti, directo a la cámara o desviado hasta este ángulo, la cámara no da la vuelta. Una carrera más hacia un lado la gira, al principio con suavidad. Desactivado: la cámara gira tras cualquier carrera."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Align the camera height on the run"
msgstr "Alinear altura de cámara al correr"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Height"
msgstr "Altura"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Align the height in"
msgstr "Alinear la altura en"

#: gdscript/ui/settings/settings_screen.tscn
msgid "While the character runs, the camera eases to this height: 0% is lowered all the way, 100% raised all the way. {camera_zoom_in/camera_zoom_out} changes the height as usual, and on the run it eases back. With the tilt aligned too, the tilt stays as it is."
msgstr "Mientras el personaje corre, la cámara pasa suavemente a esta altura: 0% es bajada del todo, 100% subida del todo. {camera_zoom_in/camera_zoom_out} cambia la altura como siempre, y al correr vuelve suavemente. Si también se alinea la inclinación, la inclinación no cambia."

#: gdscript/ui/settings/settings_screen.tscn
msgid "After you turn the camera with {camera_rotate}, it neither turns, tilts nor changes height on its own until the character stops or you start a new run with {move_to_cursor}."
msgstr "Después de girar la cámara con {camera_rotate}, no gira, no se inclina ni cambia de altura por sí sola hasta que el personaje se detenga o empieces una nueva carrera con {move_to_cursor}."

#: gdscript/ui/settings/settings_screen.tscn
msgid "The cursor keeps its aim while the camera turns"
msgstr "El cursor mantiene la mira al girar la cámara"

#: gdscript/ui/settings/settings_screen.tscn
msgid "While {move_to_cursor} is held, the cursor moves with the world and the character runs where you aimed. Without this the cursor stays put on the screen and the character veers toward it, like a steered car."
msgstr "Mientras mantienes {move_to_cursor}, el cursor se mueve con el mundo y el personaje corre adonde apuntaste. Sin esto, el cursor queda fijo en la pantalla y el personaje se desvía hacia él, como un auto al girar el volante."

#: gdscript/ui/settings/settings_screen.tscn
msgid "The camera stops at obstacles behind it"
msgstr "La cámara se detiene en obstáculos detrás"

#: gdscript/ui/settings/settings_screen.tscn
msgid "A mountain or a wall behind: the camera does not go inside but moves toward the character until there is room behind."
msgstr "Una montaña o una pared detrás: la cámara no entra en ellas, sino que se acerca al personaje hasta que hay espacio detrás."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Move in when the character is hidden"
msgstr "Acercarse si el personaje queda oculto"

#: gdscript/ui/settings/settings_screen.tscn
msgid "A fence or a wall hides the character almost entirely: the camera moves in front of the obstacle. Off: the character shows as a silhouette through the obstacle."
msgstr "Una cerca o una pared oculta casi por completo al personaje: la cámara se acerca por delante del obstáculo. Desactivado: el personaje se ve como silueta a través del obstáculo."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Display"
msgstr "Pantalla"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Fullscreen"
msgstr "Pantalla completa"

#: gdscript/ui/settings/settings_screen.tscn
msgid "The game takes the whole screen. Unavailable while the game runs inside the editor: in the Game tab or in its floating window."
msgstr "El juego ocupa toda la pantalla. No disponible mientras el juego se ejecuta dentro del editor: en la pestaña Juego (Game) o en su ventana flotante."

#: gdscript/ui/settings/settings_screen.tscn
msgid "FPS limit"
msgstr "Límite de FPS"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Unlimited"
msgstr "Sin límite"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Vertical sync (V-Sync)"
msgstr "Sincronización vertical (V-Sync)"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Physics interpolation (character and camera)"
msgstr "Interpolación de física (personaje y cámara)"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Physics runs 60 times a second. With interpolation the character and the camera are drawn smoothly between ticks at any FPS; without it they move in steps, tick by tick."
msgstr "La física se calcula 60 veces por segundo. Con interpolación, el personaje y la cámara se dibujan con suavidad entre ticks a cualquier FPS; sin ella se mueven a saltos, tick a tick."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Silhouette outline behind obstacles"
msgstr "Contorno de silueta tras obstáculos"

#: gdscript/ui/settings/settings_screen.tscn
msgid "When a tree, a house or the mountain hides the hero, the hero shows as a solid silhouette with the staff outlined on top. The outline is a light rim around the whole silhouette."
msgstr "Cuando un árbol, una casa o la montaña ocultan al héroe, este se ve como una silueta sólida con el bastón contorneado encima. El contorno es un borde claro alrededor de toda la silueta."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Interface"
msgstr "Interfaz"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Interface scale"
msgstr "Escala de la interfaz"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Hints, the FPS counter, the stamina bar and this window. 50% is the smallest, 100% the largest."
msgstr "La ayuda, el contador de FPS, la barra de resistencia y esta ventana. 50% es lo más pequeño; 100%, lo más grande."

#: gdscript/ui/settings/settings_screen.tscn
msgid "FPS counter"
msgstr "Contador de FPS"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Controls hint and speed"
msgstr "Ayuda de controles y velocidad"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Character path line"
msgstr "Línea de ruta del personaje"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Character state and events"
msgstr "Estado del personaje y eventos"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sound"
msgstr "Sonido"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Volume"
msgstr "Volumen"

#: gdscript/ui/settings/settings_screen.tscn
msgid "off"
msgstr "apagado"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Footsteps"
msgstr "Pasos"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Jump and landing"
msgstr "Salto y aterrizaje"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sprint start and sprinting"
msgstr "Arranque y sprint"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Footsteps follow the distance covered, so when sprinting they come faster and a little brighter. The higher the jump, the louder the landing."
msgstr "Los pasos siguen la distancia recorrida, así que en sprint suenan más seguido y algo más brillantes. Cuanto más alto el salto, más fuerte el aterrizaje."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Reset all"
msgstr "Restablecer todo"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Close"
msgstr "Cerrar"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "1 · Storm Mage"
msgstr "1 · Mago de tormenta"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "2 · Chronomancer"
msgstr "2 · Cronomante"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "3 · Hooded Mystic"
msgstr "3 · Místico encapuchado"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "4 · Stargazer"
msgstr "4 · Astrólogo"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "5 · Pyromancer"
msgstr "5 · Piromante"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "6 · Cryomancer"
msgstr "6 · Criomante"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "7 · Druid"
