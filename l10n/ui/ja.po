msgstr "前 %+.2f · 右 %+.2f"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Turning %+.0f°/s"
msgstr "旋回 %+.0f°/秒"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "On the ground · slope %.0f°"
msgstr "接地 · 傾斜 %.0f°"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "In the air %.2f s · vertical %+.1f m/s"
msgstr "空中 %.2f秒 · 垂直 %+.1f m/s"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Step %d · %s · cycle %.2f"
msgstr "歩数 %d · %s · 周期 %.2f"

#: addons/iso_orbit/ground_character/character_monitor.gd
