#: gdscript/demo/hud.gd
msgid "Speed: %.1f m/s"
msgstr "速度：%.1f m/s"

#: addons/iso_orbit/points_of_interest/discovery_toast.gd
msgid "Discovered: %s"
msgstr "発見：%s"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "jump"
msgstr "ジャンプ"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "left the ground"
msgstr "地面を離れた"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Speed %.1f m/s · blend %.2f"
msgstr "速度 %.1f m/s · ブレンド %.2f"

#: addons/iso_orbit/ground_character/character_monitor.gd
