msgstr "歩行なし"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Stamina %d%%"
msgstr "スタミナ %d%%"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "exhausted"
msgstr "疲労"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Standing"
msgstr "静止"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Running"
msgstr "走行"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Sprinting"
msgstr "ダッシュ"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Jumping"
msgstr "ジャンプ"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Falling"
msgstr "落下"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "step, %s"
msgstr "一歩、%s"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "touched the ground at %.1f m/s"
msgstr "%.1f m/s で接地"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "landing at %.1f m/s"
msgstr "%.1f m/s で着地"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "stair %+.2f m"
msgstr "段差 %+.2f m"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "sprint started"
msgstr "ダッシュ開始"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "sprint ended"
msgstr "ダッシュ終了"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "%.2f s"
msgstr "%.2f秒"

#: addons/iso_orbit/ground_character/character_monitor.gd
