msgstr "3 · フードの秘術師"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "4 · Stargazer"
msgstr "4 · 星読み"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "5 · Pyromancer"
msgstr "5 · 炎の魔導士"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "6 · Cryomancer"
msgstr "6 · 氷の魔導士"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "7 · Druid"
msgstr "7 · ドルイド"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "8 · Necromancer"
msgstr "8 · 死霊術師"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "9 · Archmage"
msgstr "9 · 大魔導士"

#: gdscript/ui/settings/settings_screen.tscn shared/world/world.tscn
msgid "10 · Battle Mage"
msgstr "10 · 戦闘魔導士"

#: shared/world/world.tscn
msgid "Knight"
msgstr "騎士"

#: shared/world/world.tscn
msgid "Ranger"
msgstr "レンジャー"

#: shared/world/world.tscn
msgid "Wizard"
msgstr "魔法使い"

#: shared/world/world.tscn
msgid "Dwarf"
msgstr "ドワーフ"

#: shared/world/world.tscn
msgid "Rogue"
msgstr "盗賊"

#: shared/world/mountain/mountain.tscn
msgid "Windswept Peak"
msgstr "吹きさらしの峰"

#: shared/world/world.tscn
msgid "Travelers' Camp"
msgstr "旅人の野営地"

#: shared/world/world.tscn
msgid "Farmstead by the Well"
msgstr "井戸のそばの農家"

#: shared/world/world.tscn
msgid "Ancient Circle"
msgstr "古代の円環"

#: gdscript/demo/hud.gd
msgid "Speed: %.1f m/s"
msgstr "速度：%.1f m/s"

#: addons/iso_orbit/points_of_interest/discovery_toast.gd
msgid "Discovered: %s"
msgstr "発見：%s"

#: gdscript/ui/settings/settings_screen.gd
msgid " (%d Hz)"
msgstr " (%d Hz)"

#: gdscript/ui/settings/settings_screen.gd
msgid "With V-Sync there are never more frames than the monitor's refresh rate%s, and an FPS limit above it has no effect. The smoothest limits are those that divide this rate evenly."
msgstr "V-Syncでは、フレーム数がモニターのリフレッシュレート%sを超えることはなく、それより高いFPS上限は効果がありません。最も滑らかなのは、このレートを割り切れる上限値です。"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Language"
msgstr "言語"
