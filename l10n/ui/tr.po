msgstr ""
"Project-Id-Version: Iso & Orbit - Camera and Character Controller Template\n"
"Language: tr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#: gdscript/main.tscn
msgid ""
"{move_to_cursor} on the ground — run there\n"
"Hold {move_to_cursor} — run after the cursor\n"
"{camera_rotate} + mouse — orbit the camera\n"
"{camera_zoom_in/camera_zoom_out} — lower or raise the camera\n"
"Hold {camera_rotate}, then {move_to_cursor} — run where the camera looks"
msgstr ""
"Zeminde {move_to_cursor} — oraya koş\n"
"{move_to_cursor} basılı — imlecin peşinden koş\n"
"{camera_rotate} + fare — kamerayı döndür\n"
"{camera_zoom_in/camera_zoom_out} — kamerayı alçalt veya yükselt\n"
"{camera_rotate} basılıyken {move_to_cursor} — kameranın baktığı yöne koş"

#: gdscript/main.tscn
msgid "Hold {move_to_cursor}, then {camera_rotate} — look around on the run"
msgstr "{move_to_cursor} basılıyken {camera_rotate} — koşarken etrafa bak"

#: gdscript/main.tscn
msgid "{camera_rotate} + {move_forward+move_left+move_back+move_right} — move relative to the camera"
msgstr "{camera_rotate} + {move_forward+move_left+move_back+move_right} — kameraya göre hareket et"

#: gdscript/main.tscn
msgid "{move_to_cursor} + {camera_rotate} + {move_left/move_right} — run diagonally"
msgstr "{move_to_cursor} + {camera_rotate} + {move_left/move_right} — çapraz koş"

#: gdscript/main.tscn
msgid "{sprint} — run faster"
msgstr "{sprint} — daha hızlı koş"

#: gdscript/main.tscn
msgid "{jump} — jump"
msgstr "{jump} — zıpla"

#: gdscript/main.tscn
msgid "{toggle_settings} — settings"
msgstr "{toggle_settings} — ayarlar"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Settings"
msgstr "Ayarlar"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Controls"
msgstr "Kontroller"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Held {move_to_cursor}"
msgstr "Basılı {move_to_cursor}"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Straight to the cursor"
msgstr "Doğrudan imlece"

#: gdscript/ui/settings/settings_screen.tscn
msgid "To the point along a path"
msgstr "Yol boyunca noktaya"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Off"
msgstr "Kapalı"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sidestep: face forward, {move_back} backs up"
msgstr "Yana adım: yüz önde, {move_back} ile geri geri"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Turn: face the way you go, {move_back} toward the camera"
msgstr "Dönüş: yüz gidiş yönünde, {move_back} kameraya doğru"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sidestep: face forward"
msgstr "Yana adım: yüz önde"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Diagonal: face the way you go"
msgstr "Çapraz: yüz gidiş yönünde"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Backing up ({move_back}) slower by"
msgstr "Geri yürürken ({move_back}) yavaşlama"

#: gdscript/ui/settings/settings_screen.tscn
msgid "With {camera_rotate}, {move_forward} leads where the camera looks. Sidestepping, the character faces the way the camera does: {move_left} and {move_right} step aside, {move_back} backs up. Turning, the character faces the way they go: {move_left} and {move_right} go left and right, {move_back} toward the camera. With {move_to_cursor} + {camera_rotate}, {move_left} and {move_right} veer the run diagonally forward."
msgstr "{camera_rotate} ile {move_forward}, kameranın baktığı yöne götürür. Yana adımda karakter kamerayla aynı yöne bakar: {move_left} ve {move_right} yana, {move_back} geri geri. Dönüşte karakter gittiği yöne bakar: {move_left} ve {move_right} sola ve sağa, {move_back} kameraya doğru. {move_to_cursor} + {camera_rotate} ile {move_left} ve {move_right} koşuyu çapraz ileriye saptırır."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Hide the cursor while running with {move_to_cursor} held"
msgstr "Basılı {move_to_cursor} ile koşarken imleci gizle"

#: gdscript/ui/settings/settings_screen.tscn
msgid "The cursor hides as soon as a press becomes a hold and comes back on release, where you aimed."
msgstr "Basış, basılı tutmaya dönüştüğü anda imleç gizlenir; bırakınca nişan aldığınız yerde yeniden belirir."

#: gdscript/ui/settings/settings_screen.tscn
msgid "{camera_rotate} while running with {move_to_cursor} only turns the camera"
msgstr "{move_to_cursor} ile koşarken {camera_rotate} yalnızca kamerayı döndürür"

#: gdscript/ui/settings/settings_screen.tscn
msgid "{move_to_cursor}, then {camera_rotate}: look around while the character keeps its course; afterwards the mouse steers on from where you aimed. {camera_rotate} first, or both together: run where the camera looks. Off: {move_to_cursor} and {camera_rotate} run where the camera looks in any order."
msgstr "Önce {move_to_cursor}, sonra {camera_rotate}: karakter rotasını korurken etrafa bakın; ardından fare, nişan aldığınız yerden yönlendirmeye devam eder. Önce {camera_rotate} ya da ikisi birlikte: kameranın baktığı yöne koşu. Kapalı: {move_to_cursor} ve {camera_rotate} hangi sırayla basılırsa basılsın kameranın baktığı yöne koşar."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Character"
msgstr "Karakter"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Hero look"
msgstr "Kahraman görünümü"

#: gdscript/ui/settings/settings_screen.tscn
msgid "All looks stand in a row south of the road to the ramp, each with its number overhead."
msgstr "Tüm görünümler rampaya giden yolun güneyinde sıra hâlinde durur; her birinin başının üstünde numarası var."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Float above the ground"
msgstr "Yerden yüksekte süzül"

#: gdscript/ui/settings/settings_screen.tscn
msgid "The hero hangs above the ground and glides over stairs, with no footsteps. Slopes, stairs and jumps work as usual."
msgstr "Kahraman yerden yüksekte durur ve merdivenlerin üstünde süzülür, ayak sesi yoktur. Eğimler, basamaklar ve zıplama her zamanki gibi çalışır."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Don't fall off ledges"
msgstr "Kenarlardan düşmeyi önle"

#: gdscript/ui/settings/settings_screen.tscn
msgid "At an edge the character stops, or slides along it when running at an angle, as along a wall. Low steps can still be walked down."
msgstr "Kenarda karakter durur; kenara açılı koşuyorsa duvar boyunca kayar gibi kenar boyunca kayar. Alçak basamaklardan yine de inilebilir."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Jump ({jump})"
msgstr "Zıplama ({jump})"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Jump height"
msgstr "Zıplama yüksekliği"

#: gdscript/ui/settings/settings_screen.tscn
msgid "%.1f m"
msgstr "%.1f m"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sprint ({sprint})"
msgstr "Depar ({sprint})"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Hold"
msgstr "Basılı tut"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Press: on, again: off"
msgstr "Bas: açık, tekrar: kapalı"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Speed bonus"
msgstr "Hız artışı"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sprint fatigue"
msgstr "Depar yorgunluğu"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Stamina lasts"
msgstr "Dayanıklılık süresi"

#: gdscript/ui/settings/settings_screen.tscn
msgid "%.1f s"
msgstr "%.1f sn"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Camera"
msgstr "Kamera"

#: gdscript/ui/settings/settings_screen.tscn
msgid "{camera_rotate} tilts the camera up and down"
msgstr "{camera_rotate} kamerayı yukarı ve aşağı eğer"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Off: {camera_rotate} with the mouse only orbits the camera around the character, and {camera_zoom_in/camera_zoom_out} sets its height and tilt."
msgstr "Kapalıyken {camera_rotate} ve fare kamerayı yalnızca karakterin etrafında döndürür; yüksekliği ve eğimi {camera_zoom_in/camera_zoom_out} belirler."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Turn the camera to follow the run"
msgstr "Kamerayı koşu yönüne çevir"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Align the camera tilt on the run"
msgstr "Koşarken kamera eğimini hizala"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Tilt down"
msgstr "Aşağı eğim"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Align the tilt in"
msgstr "Eğim hizalama süresi"

#: gdscript/ui/settings/settings_screen.tscn
msgid "While the character runs, the camera eases to this tilt. {camera_zoom_in/camera_zoom_out} (and {camera_rotate}, if it tilts the camera) changes the tilt as usual, and on the run it eases back."
msgstr "Karakter koşarken kamera yavaşça bu eğime gelir. {camera_zoom_in/camera_zoom_out} (ve kamerayı eğiyorsa {camera_rotate}) eğimi her zamanki gibi değiştirir; koşarken eğim yavaşça geri döner."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Turn in"
msgstr "Dönme süresi"

#: gdscript/ui/settings/settings_screen.tscn
msgid "instant"
msgstr "anında"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Except a run toward the camera"
msgstr "Kameraya doğru koşu hariç"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Angle"
msgstr "Açı"

#: gdscript/ui/settings/settings_screen.tscn
msgid "When the character runs toward you, straight at the camera or up to this angle off, the camera does not swing round. A run farther to the side turns it, gently at first. Off: the camera turns behind any run."
msgstr "Karakter size doğru, doğrudan kameraya ya da bu açıya kadar sapmayla koştuğunda kamera arkasına dönmez. Daha yana doğru bir koşu kamerayı döndürür, önce yumuşakça. Kapalıyken kamera her koşunun arkasına döner."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Align the camera height on the run"
msgstr "Koşarken kamera yüksekliğini hizala"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Height"
msgstr "Yükseklik"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Align the height in"
msgstr "Yükseklik hizalama süresi"

#: gdscript/ui/settings/settings_screen.tscn
msgid "While the character runs, the camera eases to this height: 0% is lowered all the way, 100% raised all the way. {camera_zoom_in/camera_zoom_out} changes the height as usual, and on the run it eases back. With the tilt aligned too, the tilt stays as it is."
msgstr "Karakter koşarken kamera yavaşça bu yüksekliğe gelir: %0 en alçak, %100 en yüksek konumdur. {camera_zoom_in/camera_zoom_out} yüksekliği her zamanki gibi değiştirir; koşarken yükseklik yavaşça geri döner. Eğim de hizalanıyorsa eğim değişmez."

#: gdscript/ui/settings/settings_screen.tscn
msgid "After you turn the camera with {camera_rotate}, it neither turns, tilts nor changes height on its own until the character stops or you start a new run with {move_to_cursor}."
msgstr "Kamerayı {camera_rotate} ile çevirdikten sonra kamera, karakter durana ya da {move_to_cursor} ile yeni bir koşuya başlayana kadar kendiliğinden dönmez, eğilmez ve yüksekliğini değiştirmez."

#: gdscript/ui/settings/settings_screen.tscn
msgid "The cursor keeps its aim while the camera turns"
msgstr "Kamera dönerken imleç hedefini korur"

#: gdscript/ui/settings/settings_screen.tscn
msgid "While {move_to_cursor} is held, the cursor moves with the world and the character runs where you aimed. Without this the cursor stays put on the screen and the character veers toward it, like a steered car."
msgstr "{move_to_cursor} basılıyken imleç dünyayla birlikte hareket eder ve karakter nişan aldığınız yere koşar. Bu olmadan imleç ekranda yerinde kalır ve karakter, direksiyonu kırılan bir araba gibi ona doğru döner."

#: gdscript/ui/settings/settings_screen.tscn
msgid "The camera stops at obstacles behind it"
msgstr "Kamera arkasındaki engellerde durur"

#: gdscript/ui/settings/settings_screen.tscn
msgid "A mountain or a wall behind: the camera does not go inside but moves toward the character until there is room behind."
msgstr "Arkada dağ veya duvar varsa kamera içine girmez; arkada yer açılana kadar karaktere doğru yaklaşır."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Move in when the character is hidden"
msgstr "Karakter gizlenince yaklaş"

#: gdscript/ui/settings/settings_screen.tscn
msgid "A fence or a wall hides the character almost entirely: the camera moves in front of the obstacle. Off: the character shows as a silhouette through the obstacle."
msgstr "Çit veya duvar karakteri neredeyse tamamen gizlerse kamera engelin önüne geçer. Kapalıyken karakter engelin ardından siluet olarak görünür."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Display"
msgstr "Görüntü"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Fullscreen"
msgstr "Tam ekran"

#: gdscript/ui/settings/settings_screen.tscn
msgid "The game takes the whole screen. Unavailable while the game runs inside the editor: in the Game tab or in its floating window."
msgstr "Oyun tüm ekranı kaplar. Oyun editörün içinde çalışırken kullanılamaz: Oyun (Game) sekmesinde ya da onun kayan penceresinde."

#: gdscript/ui/settings/settings_screen.tscn
msgid "FPS limit"
msgstr "FPS sınırı"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Unlimited"
msgstr "Sınırsız"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Vertical sync (V-Sync)"
msgstr "Dikey senkronizasyon (V-Sync)"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Physics interpolation (character and camera)"
msgstr "Fizik enterpolasyonu (karakter ve kamera)"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Physics runs 60 times a second. With interpolation the character and the camera are drawn smoothly between ticks at any FPS; without it they move in steps, tick by tick."
msgstr "Fizik saniyede 60 kez hesaplanır. Enterpolasyonla karakter ve kamera her FPS'te tikler arasında akıcı çizilir; o olmadan tikten tike kesik kesik hareket eder."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Silhouette outline behind obstacles"
msgstr "Engel arkasında siluet konturu"

#: gdscript/ui/settings/settings_screen.tscn
msgid "When a tree, a house or the mountain hides the hero, the hero shows as a solid silhouette with the staff outlined on top. The outline is a light rim around the whole silhouette."
msgstr "Ağaç, ev ya da dağ kahramanı gizlediğinde kahraman dolu bir siluet olarak görünür, asası üstte kendi hattıyla çizilir. Kontur, tüm siluetin çevresinde açık renkli bir kenardır."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Interface"
msgstr "Arayüz"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Interface scale"
msgstr "Arayüz ölçeği"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Hints, the FPS counter, the stamina bar and this window. 50% is the smallest, 100% the largest."
msgstr "İpuçları, FPS sayacı, dayanıklılık çubuğu ve bu pencere. %50 en küçük, %100 en büyük boyuttur."

#: gdscript/ui/settings/settings_screen.tscn
msgid "FPS counter"
msgstr "FPS sayacı"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Controls hint and speed"
msgstr "Kontrol ipuçları ve hız"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Character path line"
msgstr "Karakter yol çizgisi"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Character state and events"
msgstr "Karakter durumu ve olaylar"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sound"
msgstr "Ses"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Volume"
msgstr "Ses düzeyi"

#: gdscript/ui/settings/settings_screen.tscn
msgid "off"
msgstr "kapalı"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Footsteps"
msgstr "Ayak sesleri"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Jump and landing"
msgstr "Zıplama ve iniş"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Sprint start and sprinting"
msgstr "Depar başlangıcı ve depar"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Footsteps follow the distance covered, so when sprinting they come faster and a little brighter. The higher the jump, the louder the landing."
msgstr "Ayak sesleri kat edilen mesafeyi izler, bu yüzden deparda daha sık ve biraz daha parlak gelir. Zıplama ne kadar yüksekse iniş o kadar gürültülü olur."

#: gdscript/ui/settings/settings_screen.tscn
msgid "Reset all"
msgstr "Tümünü sıfırla"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Close"
msgstr "Kapat"

