msgstr "站立"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Running"
msgstr "奔跑"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Sprinting"
msgstr "冲刺"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Jumping"
msgstr "跳跃"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "Falling"
msgstr "下落"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "step, %s"
msgstr "迈步，%s"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "touched the ground at %.1f m/s"
msgstr "以 %.1f 米/秒触地"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "landing at %.1f m/s"
msgstr "以 %.1f 米/秒落地"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "stair %+.2f m"
msgstr "台阶 %+.2f 米"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "sprint started"
msgstr "冲刺开始"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "sprint ended"
msgstr "冲刺结束"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "%.2f s"
msgstr "%.2f 秒"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "left foot"
msgstr "左脚"

#: addons/iso_orbit/ground_character/character_monitor.gd
msgid "right foot"
msgstr "右脚"

#: gdscript/ui/settings/settings_screen.gd
msgid " (%d Hz)"
msgstr " (%d Hz)"

#: gdscript/ui/settings/settings_screen.gd
msgid "With V-Sync there are never more frames than the monitor's refresh rate%s, and an FPS limit above it has no effect. The smoothest limits are those that divide this rate evenly."
msgstr "开启 V-Sync 时，帧数永远不会超过显示器刷新率%s，高于刷新率的 FPS 上限不起作用。能整除该刷新率的上限最流畅。"

#: gdscript/ui/settings/settings_screen.tscn
msgid "Language"
msgstr "语言"

#: gdscript/main.tscn
msgid "Hold {move_to_cursor} and the hero runs after the cursor; let go, and it stops."
msgstr "按住{move_to_cursor}，英雄会追着光标奔跑；松开即停下。"

#: gdscript/main.tscn
msgid "Hold {camera_rotate} and move the mouse to turn the camera; {camera_zoom_in/camera_zoom_out} lowers and raises it."
msgstr "按住{camera_rotate}并移动鼠标可旋转相机；{camera_zoom_in/camera_zoom_out}可降低和升高相机。"

#: gdscript/main.tscn
msgid "Hold {camera_rotate}, then {move_to_cursor}: the hero runs where the camera looks."
msgstr "先按住{camera_rotate}，再按住{move_to_cursor}：英雄朝相机所看的方向奔跑。"

#: gdscript/main.tscn
msgid "While the hero runs after the cursor, hold {camera_rotate} to look around: the run keeps its course."
msgstr "英雄追着光标奔跑时，按住{camera_rotate}即可环顾四周：奔跑方向保持不变。"

#: gdscript/main.tscn
msgid "{sprint} makes the hero run faster for as long as stamina lasts."
msgstr "按住 {sprint}，英雄会在体力耗尽前跑得更快。"

#: gdscript/main.tscn
msgid "{toggle_settings} opens the settings: controls, camera, display, sound and more."
msgstr "按 {toggle_settings} 打开设置：操作、相机、显示、声音等。"

