[gd_scene format=3]

[ext_resource type="PackedScene" path="res://shared/world/world.tscn" id="1_world"]
[ext_resource type="PackedScene" path="res://gdscript/player/player.tscn" id="2_player"]
[ext_resource type="Script" path="res://addons/iso_orbit/click_to_move/point_click_move_input.gd" id="3_input"]
[ext_resource type="Script" path="res://addons/iso_orbit/orbit_camera/orbit_camera_rig.gd" id="4_camera"]
[ext_resource type="PackedScene" path="res://addons/iso_orbit/click_to_move/click_marker.tscn" id="5_marker"]
[ext_resource type="Script" path="res://addons/iso_orbit/click_to_move/navigation_path_view.gd" id="6_path_view"]
[ext_resource type="Script" path="res://gdscript/demo/hud.gd" id="7_hud"]
[ext_resource type="PackedScene" path="res://addons/iso_orbit/ui_screens/fps_counter.tscn" id="8_fps"]
[ext_resource type="PackedScene" path="res://addons/iso_orbit/points_of_interest/discovery_toast.tscn" id="13_toast"]
[ext_resource type="Script" path="res://gdscript/demo/settings_applier.gd" id="9_applier"]
[ext_resource type="PackedScene" path="res://gdscript/ui/ui_root.tscn" id="10_ui_root"]
[ext_resource type="Script" path="res://addons/iso_orbit/ground_character/character_action_input.gd" id="11_actions"]
[ext_resource type="PackedScene" path="res://addons/iso_orbit/ground_character/stamina_bar.tscn" id="12_stamina_bar"]
[ext_resource type="Script" path="res://addons/iso_orbit/orbit_camera/camera_arm.gd" id="14_arm"]

[node name="Main" type="Node3D"]

[node name="World" parent="." instance=ExtResource("1_world")]

[node name="Player" parent="." groups=["player"] instance=ExtResource("2_player")]

[node name="PlayerInput" type="Node" parent="." node_paths=PackedStringArray("mover", "camera")]
script = ExtResource("3_input")
mover = NodePath("../Player/NavigationMover")
camera = NodePath("../CameraRig/CameraArm/Camera3D")

[node name="PlayerActionInput" type="Node" parent="." node_paths=PackedStringArray("character")]
script = ExtResource("11_actions")
character = NodePath("../Player")

[node name="CameraRig" type="Node3D" parent="." node_paths=PackedStringArray("target", "arm")]
script = ExtResource("4_camera")
target = NodePath("../Player")
arm = NodePath("CameraArm")

[node name="CameraArm" type="Node3D" parent="CameraRig" node_paths=PackedStringArray("fade_target")]
script = ExtResource("14_arm")
fade_target = NodePath("../../Player/Visual")

[node name="Camera3D" type="Camera3D" parent="CameraRig/CameraArm"]
current = true
fov = 45.0
far = 300.0

[node name="ClickMarker" parent="." instance=ExtResource("5_marker")]

[node name="PathView" type="MeshInstance3D" parent="." node_paths=PackedStringArray("mover")]
visible = false
script = ExtResource("6_path_view")
mover = NodePath("../Player/NavigationMover")

[node name="Hud" type="CanvasLayer" parent="." node_paths=PackedStringArray("mover")]
script = ExtResource("7_hud")
mover = NodePath("../Player/NavigationMover")

[node name="Panel" type="PanelContainer" parent="Hud"]
offset_left = 12.0
offset_top = 12.0
offset_right = 12.0
offset_bottom = 12.0
mouse_filter = 2

[node name="Lines" type="VBoxContainer" parent="Hud/Panel"]
layout_mode = 2
mouse_filter = 2

[node name="Help" type="Label" parent="Hud/Panel/Lines"]
layout_mode = 2
text = "LMB on the ground — run there
Hold LMB — run after the cursor
Hold LMB + RMB — run where the camera looks
RMB + mouse — orbit the camera
Wheel — lower or raise the camera"

[node name="KeysHelp" type="Label" parent="Hud/Panel/Lines"]
layout_mode = 2
text = "RMB + WASD — move relative to the camera"

[node name="StrafeHelp" type="Label" parent="Hud/Panel/Lines"]
layout_mode = 2
text = "LMB + RMB + A/D — run diagonally"

[node name="SprintHelp" type="Label" parent="Hud/Panel/Lines"]
layout_mode = 2
text = "Shift — run faster"

[node name="JumpHelp" type="Label" parent="Hud/Panel/Lines"]
layout_mode = 2
text = "Space — jump"

[node name="MenuHelp" type="Label" parent="Hud/Panel/Lines"]
layout_mode = 2
text = "F10 — settings"

[node name="SpeedLabel" type="Label" parent="Hud/Panel/Lines"]
unique_name_in_owner = true
layout_mode = 2
text = "Speed: 0.0 m/s"

[node name="FpsCounter" parent="Hud" instance=ExtResource("8_fps")]

[node name="DiscoveryToast" parent="Hud" instance=ExtResource("13_toast")]

[node name="StaminaBar" parent="Hud" node_paths=PackedStringArray("stamina") instance=ExtResource("12_stamina_bar")]
stamina = NodePath("../../Player/Stamina")

[node name="SettingsApplier" type="Node" parent="." node_paths=PackedStringArray("player", "player_actions", "ledge_guard", "player_input", "camera_rig", "camera_arm", "character_sounds", "path_view", "help_panel", "fps_counter", "keys_help", "strafe_help", "sprint_help", "jump_help", "player_appearance", "player_silhouette")]
script = ExtResource("9_applier")
player_appearance = NodePath("../Player/Appearance")
player_silhouette = NodePath("../Player/Silhouette")
player = NodePath("../Player")
player_actions = NodePath("../PlayerActionInput")
ledge_guard = NodePath("../Player/LedgeGuard")
player_input = NodePath("../PlayerInput")
camera_rig = NodePath("../CameraRig")
camera_arm = NodePath("../CameraRig/CameraArm")
character_sounds = NodePath("../Player/Sounds")
path_view = NodePath("../PathView")
help_panel = NodePath("../Hud/Panel")
fps_counter = NodePath("../Hud/FpsCounter")
keys_help = NodePath("../Hud/Panel/Lines/KeysHelp")
strafe_help = NodePath("../Hud/Panel/Lines/StrafeHelp")
sprint_help = NodePath("../Hud/Panel/Lines/SprintHelp")
jump_help = NodePath("../Hud/Panel/Lines/JumpHelp")

[node name="UiRoot" parent="." instance=ExtResource("10_ui_root")]

[connection signal="destination_picked" from="PlayerInput" to="ClickMarker" method="show_at"]
[connection signal="hold_started" from="PlayerInput" to="ClickMarker" method="fade_out"]
[connection signal="hold_pending_changed" from="PlayerInput" to="CameraRig" method="set_follow_paused"]
[connection signal="arrived" from="Player/NavigationMover" to="ClickMarker" method="fade_out"]
[connection signal="destination_cancelled" from="Player/NavigationMover" to="ClickMarker" method="fade_out"]
