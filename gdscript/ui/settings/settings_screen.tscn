[node name="LookAroundHint" type="Label" parent="Center/Window/Layout/Tabs/Gameplay/Page/List"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "LMB, then RMB: look around while the character keeps its course; afterwards the mouse steers on from where you aimed. RMB first, or both together: run where the camera looks. Off: both buttons run where the camera looks in any order."
autowrap_mode = 3

