[node name="CameraKeysHint" type="Label" parent="Center/Window/Layout/Tabs/Gameplay/Page/List" unique_id=1671307352]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "With {camera_rotate}, {move_forward} leads where the camera looks. Sidestepping, the character faces the way the camera does: {move_left} and {move_right} step aside, {move_back} backs up. Turning, the character faces the way they go: {move_left} and {move_right} go left and right, {move_back} toward the camera. With {move_to_cursor} + {camera_rotate}, {move_left} and {move_right} veer the run diagonally forward."
autowrap_mode = 3

