[node name="CameraKeysHint" type="Label" parent="Center/Window/Layout/Tabs/Gameplay/Page/List"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_type_variation = &"HintLabel"
text = "With RMB, W leads where the camera looks. Sidestepping, the character faces the way the camera does: A and D step aside, S backs up. Turning, the character faces the way they go: A and D go left and right, S toward the camera. With both buttons, A and D veer the run diagonally forward."
autowrap_mode = 3

[node name="HideCursor" type="CheckButton" parent="Center/Window/Layout/Tabs/Gameplay/Page/List"]
